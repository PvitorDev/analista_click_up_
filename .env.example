# Ambiente: development | production
ENV=development

# Postgres
DATABASE_URL=postgresql://clickup:clickup@localhost:5432/clickup_analyst

# Redis Stack (chat + RAG). No Docker Compose a API usa redis://redis:6379.
REDIS_URL=redis://localhost:6379

# Token de serviço do worker (somente leitura). Não é o OAuth do usuário.
CLICKUP_API_TOKEN=pk_...
# Workspace (team) a espelhar. Vazio = descobre via GET /v2/team se só houver um.
# Com vários: rode `make teams` ou veja o id na URL https://app.clickup.com/{team_id}/...
CLICKUP_TEAM_ID=

# Nomes dos custom fields (A5)
CLICKUP_FIELD_PRIORITY=Prioridade
CLICKUP_FIELD_CONTEXT=Contexto

# Polling
SYNC_INTERVAL_SECONDS=300

# OAuth do dashboard (ClickUp App)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=analyst_session

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Claude (blocos B, D, E, chat). Sonnet 4 (20250514) foi aposentado; use 4.6+.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# NUNCA ligar em produção. Recusa boot se ENV=production.
DEV_BYPASS_AUTH=false
